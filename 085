          "x": 18,
          "y": 25,
          "pages": {
            "0": {
              "conditions": {
                "switch1_id": 1027
              },
              "dialogue_blocks": [
                {
                  "start_index": 6,
                  "type": "text",
                  "lines": [
                    "\\C[2]Yes, child. You have done my bidding well."
                  ]
                },
                {
                  "start_index": 7,
                  "type": "text",
                  "lines": [
                    "\\C[2]Without these feathers, there is no longer anything ",
                    "preventing me from reaching into everyone's dreams."
                  ]
                },
                {
                  "start_index": 9,
                  "type": "text",
                  "lines": [
                    "\\C[2]We'll finally be able to plunge the world in an endless ",
                    "nightma-\\wtnp[10] "
                  ]
                },
                {
                  "start_index": 41,
                  "type": "text",
                  "lines": [
                    "\\C[2]Child... I must return to New Moon Island. Come join ",
                    "me in the darkness..."
                  ]
                },
                {
                  "start_index": 76,
                  "type": "text",
                  "lines": [
                    "\\C[9]It's not too late. The light of the full moon ",
                    "can absolve you still."
                  ]
                },
                {
                  "start_index": 78,
                  "type": "text",
                  "lines": [
                    "\\C[9]We must stop the horrors of the night from spreading ",
                    "further."
                  ]
                }
              ]
            }
          }
        },
        "1": {
          "name": "darkrai",
          "x": 16,
          "y": 21,
          "pages": {
            "0": {
              "conditions": {
              },
              "dialogue_blocks": [
                {
                  "start_index": 3,
                  "type": "text",
                  "lines": [
                    "\\C[2]Yes, of course you would choose to come. You have ",
                    "already proven your loyalty to me after all."
                  ]
                },
                {
                  "start_index": 5,
                  "type": "text",
                  "lines": [
                    "\\C[2]Humans have expanded upon my territory, but with ",
                    "these out of the way, I now have the power to drive them ",
                    "mad with nightmares to chase them away."
                  ]
                },
                {
                  "start_index": 8,
                  "type": "text",
                  "lines": [
                    "\\C[2]The Fullmoon guardian is the only problem that ",
                    "remains. With it around, I cannot use my powers effectively."
                  ]
                },
                {
                  "start_index": 10,
                  "type": "text",
                  "lines": [
                    "\\C[2]Place this feather on the bed on \\C[1]Fullmoon ",
                    "Island\\C[2] to weaken the guardian of dreams. Then strike."
                  ]
                }
              ]
            },
            "1": {
              "conditions": {
                "self_switch": "A"
              },
              "dialogue_blocks": [
                {
                  "start_index": 3,
                  "type": "text",
                  "lines": [
                    "\\C[2]Place the corrupted feather on the bed on ",
                    "\\C[1]Fullmoon Island\\C[2] to weaken the island's guardian. ",
                    "Then strike."
                  ]
                }
              ]
            },
            "2": {
              "conditions": {
                "switch1_id": 1030
              },
              "dialogue_blocks": [
                {
                  "start_index": 2,
                  "type": "text",
                  "lines": [
                    "\\C[2]Traitor! What have you done to my land?"
                  ]
                },
                {
                  "start_index": 9,
                  "type": "text",
                  "lines": [
                    "Daarrrrrr!"
                  ]
                }
              ]
            }
          }
        },
        "19": {
          "name": "darkrai",
          "x": 25,
          "y": 21,
          "pages": {
            "0": {
              "conditions": {
                "switch1_id": 1030
              },
              "dialogue_blocks": [
                {
                  "start_index": 4,
