          "start_index": 73,
          "type": "choices",
          "choices": [
            "Repeat",
            "Understood!"
          ],
          "cancel_type": 2
        },
        {
          "start_index": 77,
          "type": "text",
          "lines": [
            "Please also consider reporting the fake website to Google ",
            "to help us combat scammers and keep the community ",
            "safe."
          ]
        },
