    "819": {
      "name": "Halfmoon Island",
      "events": {
        "6": {
          "name": "EV006",
          "pages": {
            "0": {
              "conditions": { "switch1_id": 1027 },
              "dialogue_blocks": [
                {
                  "start_index": 7,
                  "type": "text",
                  "lines": [
                    "\\C[2]Yes. You have served",
                    "your purpose well."
                  ]
                },
                {
                  "start_index": 17,
                  "type": "text",
                  "lines": [
                    "\\C[2]Give me the feathers",
                    "you have collected."
                  ]
                },
                {
                  "start_index": 19,
                  "type": "text",
                  "lines": [
                    "Hand over the \\C[1]Lunar",
                    "Feathers\\C[0]?"
                  ]
                },
                {
                  "start_index": 21,
                  "type": "choices",
                  "choices": ["Yes", "No"]
                },
                {
                  "start_index": 23,
                  "type": "text",
                  "lines": [
                    "\\PN handed over all of",
                    "the Lunar Feathers."
                  ]
                },
                {
                  "start_index": 30,
                  "type": "text",
                  "lines": [
                    "\\C[2]You are no longer",
                    "needed. Leave."
                  ]
                },
                {
                  "start_index": 51,
                  "type": "text",
                  "lines": [
                    "\\C[2]Was this all for",
                    "nothing? Give them to me."
                  ]
                },
                {
                  "start_index": 71,
                  "type": "text",
                  "lines": [
                    "\\C[2]Humans have settled",
                    "on my land."
                  ]
                },
                {
                  "start_index": 72,
                  "type": "text",
                  "lines": [
                    "\\C[2]Without these feathers",
                    "guarding their dreams,",
                    "I will consume them all."
                  ]
                },
                {
                  "start_index": 75,
                  "type": "text",
                  "lines": [
                    "\\C[2]Every living thing that",
                    "sets foot here will know",
                    "only nightmares."
                  ]
                },
                {
                  "start_index": 107,
                  "type": "text",
                  "lines": [
                    "\\C[2]Come to New Moon",
                    "Island. We have unfinished",
                    "business."
                  ]
                },
                {
                  "start_index": 145,
                  "type": "text",
                  "lines": [
                    "\\C[9]It is not too late.",
                    "The full moon still shines."
                  ]
                },
                {
                  "start_index": 147,
                  "type": "text",
                  "lines": [
                    "\\C[9]We must stop the",
                    "nightmares from spreading.",
                    "There is still time."
                  ]
                }
              ]
            }
          }
        }
      }
    },
