                  "start_index": 7,
                  "type": "text",
                  "lines": [
                    "They came in before dawn. Sealed",
                    "the doors. The boss \u2014 Giovanni \u2014",
                    "he went straight to the top\nfloor."
                  ]
                }
              ]
            },
            "2": {
              "conditions": {
                "switch1_id": 228,
                "self_switch": "A"
              },
              "dialogue_blocks": [
                {
                  "start_index": 1,
                  "type": "text",
                  "lines": [
