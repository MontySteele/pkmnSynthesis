        "17": {
          "name": "Trainer(4)",
          "pages": {
            "0": {
              "conditions": {},
              "dialogue_blocks": [
                {
                  "start_index": 7,
                  "type": "text",
                  "lines": [
                    "Finally! Silph kept me stuck in",
                    "accounting for years. Now I'm\non the winning side!"
                  ]
                },
                {
                  "start_index": 9,
                  "type": "text",
                  "lines": [
                    "Wait \u2014 you're not one of ours!"
                  ]
                },
                {
                  "start_index": 13,
                  "type": "text",
                  "lines": [
                    "Help! I'm just an accountant!\nI didn't mean any of that!"
                  ]
                }
              ]
            },
            "1": {
              "conditions": {
                "self_switch": "A"
              },
              "dialogue_blocks": [
                {
                  "start_index": 1,
                  "type": "text",
                  "lines": [
                    "Look... Silph never promoted me.",
                    "Rocket said they'd give me a\nreal position. Can you blame me?"
                  ]
                }
              ]
            }
          }
        },
        "12": {
          "name": "Trainer(3)",
          "pages": {
            "0": {
              "conditions": {},
              "dialogue_blocks": [
                {
                  "start_index": 6,
                  "type": "text",
                  "lines": [
                    "Hey \u2014 did you memorize the warp",
                    "panel layout? The boss wants\neveryone to know the routes."
                  ]
                },
                {
                  "start_index": 9,
                  "type": "text",
                  "lines": [
                    "Hold on... You're not a grunt.\nYou're a kid!"
                  ]
                },
                {
                  "start_index": 13,
                  "type": "text",
                  "lines": [
                    "No civilians on this floor!"
                  ]
                }
              ]
            },
            "1": {
              "conditions": {
                "self_switch": "A"
              },
              "dialogue_blocks": [
                {
                  "start_index": 1,
                  "type": "text",
                  "lines": [
