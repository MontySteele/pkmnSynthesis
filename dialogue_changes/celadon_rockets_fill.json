  "maps": {
    "431": {
      "name": "Celadon Sewers",
      "events": {
        "44": {
          "name": "Trainer(4) (Grunt — Sentry)",
          "pages": {
            "0": {
              "conditions": {},
              "dialogue_blocks": [
                {
                  "start_index": 5,
                  "type": "text",
                  "lines": [
                    "Intruders! This area is under",
                    "Rocket jurisdiction. The city",
                    "signed off on it. Legally."
                  ]
                }
              ]
            },
            "1": {
              "conditions": {"self_switch": "A"},
              "dialogue_blocks": [
                {
                  "start_index": 1,
                  "type": "text",
                  "lines": [
                    "You're trespassing on private",
                    "property. The permits are real.",
                    "Ask the city council."
                  ]
                },
                {
                  "start_index": 3,
                  "type": "text",
                  "lines": [
                    "This is a serious offense.",
                    "But who's going to arrest us?"
                  ]
                }
              ]
            }
          }
        },
        "39": {
          "name": "Trainer(3) (Grunt — Territorial)",
          "pages": {
            "0": {
              "conditions": {},
              "dialogue_blocks": [
                {
                  "start_index": 5,
                  "type": "text",
                  "lines": [
                    "You really shouldn't be down",
                    "here. For your own sake.",
                    "The sewers aren't safe for",
                    "civilians anymore."
                  ]
                }
              ]
            },
            "1": {
              "conditions": {"self_switch": "A"},
              "dialogue_blocks": [
                {
                  "start_index": 1,
                  "type": "text",
                  "lines": [
                    "I forbid you from going",
                    "further. What we're building",
                    "here is bigger than you know."
                  ]
                }
              ]
            }
          }
        },
        "40": {
          "name": "Trainer(3) (Grunt — Rights Arguer)",
          "pages": {
            "0": {
              "conditions": {},
              "dialogue_blocks": [
                {
                  "start_index": 5,
                  "type": "text",
                  "lines": [
                    "Well well. What have we here?",
                    "Two more heroes come to clean",
                    "up Celadon's dirty secret?"
                  ]
                }
              ]
            },
            "1": {
              "conditions": {"self_switch": "A"},
              "dialogue_blocks": [
                {
                  "start_index": 1,
                  "type": "text",
                  "lines": [
                    "The sewers are public. We have",
                    "every right to be here.",
                    "More right than you, honestly."
                  ]
                }
              ]
            }
          }
        },
        "46": {
          "name": "Trainer(4) (Grunt — Uniform Spotter)",
          "pages": {
            "0": {
              "conditions": {},
              "dialogue_blocks": [
                {
                  "start_index": 6,
                  "type": "text",
                  "lines": [
                    "What are you doing?! You're",
                    "not worthy of that uniform!"
                  ]
                },
                {
                  "start_index": 10,
                  "type": "text",
                  "lines": [
                    "Hey, you aren't Rocket.",
                    "Clever disguise, though.",
                    "Almost had me."
                  ]
                }
              ]
            },
            "1": {
              "conditions": {"self_switch": "A"},
              "dialogue_blocks": [
                {
                  "start_index": 1,
                  "type": "text",
                  "lines": [
                    "Look all you want. You won't",
                    "find the hideout entrance.",
                    "It's better hidden than",
                    "Erika's conscience."
                  ]
                }
              ]
            }
          }
        },
        "41": {
          "name": "Trainer(3) (Grunt — Squatter)",
          "pages": {
            "0": {
              "conditions": {},
              "dialogue_blocks": [
                {
                  "start_index": 5,
                  "type": "text",
                  "lines": [
                    "We claimed these sewers. Fair",
                    "and square. The city didn't",
                    "want them. We did."
                  ]
                }
              ]
            },
            "1": {
              "conditions": {"self_switch": "A"},
              "dialogue_blocks": [
                {
                  "start_index": 1,
                  "type": "text",
                  "lines": [
                    "Go back to the surface where",
                    "it's pretty. Leave the ugly",
                    "work to us."
                  ]
                }
              ]
            }
          }
        },
        "36": {
          "name": "Trainer(3) (Grunt — Loyal)",
          "pages": {
            "0": {
              "conditions": {},
              "dialogue_blocks": [
                {
                  "start_index": 6,
                  "type": "text",
                  "lines": [
                    "Take off that uniform, traitor!",
                    "You haven't earned the right",
                    "to wear it."
                  ]
                },
                {
                  "start_index": 10,
                  "type": "text",
                  "lines": [
                    "Our leader is strong. Stronger",
                    "than anyone the League has.",
                    "That's why we follow him."
                  ]
                }
              ]
            },
            "1": {
              "conditions": {"self_switch": "A"},
              "dialogue_blocks": [
                {
                  "start_index": 1,
                  "type": "text",
                  "lines": [
                    "What is Rocket doing here?",
                    "Building something. Something",
                    "the League won't."
                  ]
                },
                {
                  "start_index": 3,
                  "type": "text",
                  "lines": [
                    "That's all you need to know."
                  ]
                }
              ]
            }
          }
        },
        "53": {
          "name": "Trainer(5) (Grunt — Water Puzzle)",
          "pages": {
            "0": {
              "conditions": {},
              "dialogue_blocks": [
                {
                  "start_index": 5,
                  "type": "text",
                  "lines": [
                    "So you figured out the water",
                    "levels. Smart kid. Won't help",
                    "you much further down."
                  ]
                }
              ]
            },
            "1": {
              "conditions": {"self_switch": "A"},
              "dialogue_blocks": [
                {
                  "start_index": 1,
                  "type": "text",
                  "lines": [
                    "Don't bother looking for a",
                    "secret hideout. Even if you",
                    "found it, you wouldn't last",
                    "five minutes inside."
                  ]
                }
              ]
            }
          }
        },
        "42": {
          "name": "Trainer(4) (Grunt — Wet Complainer)",
          "pages": {
            "0": {
              "conditions": {},
              "dialogue_blocks": [
                {
                  "start_index": 5,
                  "type": "text",
                  "lines": [
                    "Hey! Stop messing with the",
                    "water level! I didn't sign up",
                    "for sewer duty to get wet."
                  ]
                }
              ]
            },
            "1": {
              "conditions": {"self_switch": "A"},
              "dialogue_blocks": [
                {
                  "start_index": 1,
                  "type": "text",
                  "lines": [
                    "We keep it dry down here for",
                    "easier access to our secret...",
                    "Wait. Forget I said anything."
                  ]
                }
              ]
            }
          }
        },
        "43": {
          "name": "Trainer(4) (Grunt — Doorman)",
          "pages": {
            "0": {
              "conditions": {},
              "dialogue_blocks": [
                {
                  "start_index": 5,
                  "type": "text",
                  "lines": [
                    "This passage is Rocket only.",
                    "Members get dental. You don't."
                  ]
                },
                {
                  "start_index": 7,
                  "type": "text",
                  "lines": [
                    "Team Rocket members only.",
                    "Badge or no badge."
                  ]
                }
              ]
            },
            "1": {
              "conditions": {"self_switch": "A"},
              "dialogue_blocks": [
                {
                  "start_index": 1,
                  "type": "text",
                  "lines": [
                    "Fine, go ahead. You won't",
                    "make it far. The real security",
                    "starts inside."
                  ]
                }
              ]
            }
          }
        },
