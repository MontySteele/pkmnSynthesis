        "4": {
          "name": "EV004 (Giovanni — Post-Battle + Silph Scope)",
          "pages": {
            "0": {
              "conditions": {},
              "dialogue_blocks": [
                {
                  "start_index": 1,
                  "type": "text",
                  "lines": [
                    "Beaten by a child. How",
                    "humiliating. You don't",
                    "even know what you're",
                    "protecting."
                  ]
                },
                {
                  "start_index": 3,
                  "type": "text",
                  "lines": [
                    "Enjoy your little victory.",
                    "The League will eat itself",
                    "alive. I was the cure and",
                    "you chose the disease."
                  ]
                },
                {
                  "start_index": 6,
                  "type": "text",
                  "lines": [
                    "This changes nothing. You",
                    "kicked over one anthill.",
                    "Rocket is an idea. You",
                    "can't beat an idea."
                  ]
                },
                {
                  "start_index": 40,
                  "type": "text",
                  "lines": [
                    "Whew! Thank goodness you",
                    "were here, \\PN!"
                  ]
                },
                {
                  "start_index": 42,
                  "type": "text",
                  "lines": [
                    "I couldn't have done it alone.",
                    "Thank you. Truly."
                  ]
                },
                {
                  "start_index": 44,
                  "type": "text",
                  "lines": [
                    "This Silph Scope Giovanni",
                    "left behind... It lets you",
                    "see Ghost-type Pok\u00e9mon.",
                    "The League classified it."
                  ]
                },
                {
                  "start_index": 47,
                  "type": "text",
                  "lines": [
                    "With this, you can go save",
                    "Mr. Fuji atop Pok\u00e9mon Tower.",
                    "He's been trapped there by",
                    "whatever Rocket disturbed."
                  ]
                },
                {
                  "start_index": 51,
                  "type": "text",
                  "lines": [
                    "I should head back to my gym.",
                    "I have much to think about."
                  ]
                },
                {
                  "start_index": 53,
                  "type": "text",
                  "lines": [
                    "Come challenge me when you're",
                    "ready. You've earned it."
                  ]
                }
              ]
            }
          }
        },
