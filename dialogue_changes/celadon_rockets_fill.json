    "446": {
      "name": "Celadon Sewers (Lower)",
      "events": {
        "27": {
          "name": "Trainer(5) (Grunt — Sentry 2)",
          "pages": {
            "0": {
              "conditions": {},
              "dialogue_blocks": [
                {
                  "start_index": 5,
                  "type": "text",
                  "lines": [
                    "Intruders. Again. Doesn't",
                    "anyone respect private",
                    "infrastructure anymore?"
                  ]
                }
              ]
            },
            "1": {
              "conditions": {"self_switch": "A"},
              "dialogue_blocks": [
                {
                  "start_index": 1,
                  "type": "text",
                  "lines": [
                    "Trespassing is a serious",
                    "offense. Not that anyone in",
                    "Celadon enforces the law."
                  ]
                },
                {
                  "start_index": 3,
                  "type": "text",
                  "lines": [
                    "That's sort of our whole",
                    "business model."
                  ]
                }
              ]
            }
          }
        },
        "28": {
          "name": "Trainer(3) (Grunt — Defiant)",
          "pages": {
            "0": {
              "conditions": {},
              "dialogue_blocks": [
                {
                  "start_index": 5,
                  "type": "text",
                  "lines": [
                    "Well well. More surface-",
                    "dwellers slumming it in the",
                    "sewers. How civic-minded."
                  ]
                }
              ]
            },
            "1": {
              "conditions": {"self_switch": "A"},
              "dialogue_blocks": [
                {
                  "start_index": 1,
                  "type": "text",
                  "lines": [
                    "These sewers are public space.",
                    "We're exercising our rights.",
                    "With Pok\u00e9mon. Aggressively."
                  ]
                }
              ]
            }
          }
        },
        "23": {
          "name": "Trainer(3) (Grunt — Spotter)",
          "pages": {
            "0": {
              "conditions": {},
              "dialogue_blocks": [
                {
                  "start_index": 5,
                  "type": "text",
                  "lines": [
                    "Hey, you aren't Rocket.",
                    "What are civilians doing",
                    "this deep?"
                  ]
                },
                {
                  "start_index": 7,
                  "type": "text",
                  "lines": [
                    "This is restricted. By us.",
                    "Which is basically the same",
                    "as officially."
                  ]
                }
              ]
            },
            "1": {
              "conditions": {"self_switch": "A"},
              "dialogue_blocks": [
                {
                  "start_index": 1,
                  "type": "text",
                  "lines": [
                    "Look around. You won't find",
                    "the hideout. We've hidden it",
                    "better than Erika hides her",
                    "tax records."
                  ]
                }
              ]
            }
          }
        },
        "29": {
          "name": "Trainer(3) (Grunt — Warning)",
          "pages": {
            "0": {
              "conditions": {},
              "dialogue_blocks": [
                {
                  "start_index": 5,
                  "type": "text",
                  "lines": [
                    "You shouldn't be down here.",
                    "Not because of us. Because",
                    "of what lives in the water."
                  ]
                }
              ]
            },
            "1": {
              "conditions": {"self_switch": "A"},
              "dialogue_blocks": [
                {
                  "start_index": 1,
                  "type": "text",
                  "lines": [
                    "I forbid you from going",
                    "further. For your own good.",
                    "Honestly."
                  ]
                }
              ]
            }
          }
        },
        "24": {
          "name": "Trainer(3) (Grunt — Bravado)",
          "pages": {
            "0": {
              "conditions": {},
              "dialogue_blocks": [
                {
                  "start_index": 5,
                  "type": "text",
                  "lines": [
                    "Two against one? Fine. I",
                    "didn't join Rocket because",
                    "I was afraid of bad odds."
                  ]
                }
              ]
            },
            "1": {
              "conditions": {"self_switch": "A"},
              "dialogue_blocks": [
                {
                  "start_index": 1,
                  "type": "text",
                  "lines": [
                    "What's Rocket doing here?",
                    "Making fusion accessible.",
                    "The League charges a fortune",
                    "for licenses. We don't."
                  ]
                },
                {
                  "start_index": 3,
                  "type": "text",
                  "lines": [
                    "Call us criminals if you want.",
                    "We call ourselves practical."
                  ]
                }
              ]
            }
          }
        },
        "30": {
          "name": "Trainer(5) (Grunt — Water Smarts)",
          "pages": {
            "0": {
              "conditions": {},
              "dialogue_blocks": [
                {
                  "start_index": 5,
                  "type": "text",
                  "lines": [
                    "Figured out the water levels?",
                    "Clever. Most intruders drown",
                    "before they get this far."
                  ]
                }
              ]
            },
            "1": {
              "conditions": {"self_switch": "A"},
              "dialogue_blocks": [
                {
                  "start_index": 1,
                  "type": "text",
                  "lines": [
                    "There's no secret hideout",
                    "here. Definitely not behind",
                    "any suspiciously clean walls."
                  ]
                }
              ]
            }
          }
        },
        "34": {
          "name": "Trainer(4) (Grunt — Can't Swim)",
          "pages": {
            "0": {
              "conditions": {},
              "dialogue_blocks": [
                {
                  "start_index": 1,
                  "type": "text",
                  "lines": [
                    "Please stop flooding the",
                    "sewers! I can't swim! They",
                    "didn't mention this in the",
                    "recruitment brochure!"
