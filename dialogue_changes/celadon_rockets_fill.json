    "457": {
      "name": "Team Rocket Hideout (Boss Floor)",
      "events": {
        "1": {
          "name": "EV001 (Giovanni — Pre-Battle A)",
          "pages": {
            "0": {
              "conditions": {},
              "dialogue_blocks": [
                {
                  "start_index": 3,
                  "type": "text",
                  "lines": [
                    "\\PN! I'm sorry! I couldn't",
                    "do anything. He was too",
                    "strong for me alone..."
                  ]
                },
                {
                  "start_index": 6,
                  "type": "text",
                  "lines": [
                    "You got this far. I under-",
                    "estimated Oak's taste in",
                    "errand-runners."
                  ]
                },
                {
                  "start_index": 21,
                  "type": "text",
                  "lines": [
                    "Snuck past my guards in",
                    "a stolen uniform? Adorable.",
                    "You have no idea what",
                    "you've walked into."
                  ]
                },
                {
                  "start_index": 26,
                  "type": "text",
                  "lines": [
                    "The old man chose to play",
                    "martyr. Nobody forced him.",
                    "People who get in my way",
                    "learn what that costs."
                  ]
                },
                {
                  "start_index": 30,
                  "type": "text",
                  "lines": [
                    "Every trainer uses Pok\u00e9mon",
                    "as tools. I'm the only one",
                    "honest enough to say it",
                    "out loud."
                  ]
                },
                {
                  "start_index": 33,
                  "type": "text",
                  "lines": [
                    "The League hoards fusion",
                    "for the elite. I democra-",
                    "tize it. And THAT makes",
                    "me the villain? Please."
                  ]
                },
                {
                  "start_index": 36,
                  "type": "text",
                  "lines": [
                    "I am Giovanni. The only",
                    "honest man in Kanto."
                  ]
                },
                {
                  "start_index": 38,
                  "type": "text",
                  "lines": [
                    "Enough. I don't explain",
                    "myself to children. Let",
                    "me educate you the only",
                    "way you'll understand."
                  ]
                }
              ]
            }
          }
        },
