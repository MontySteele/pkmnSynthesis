    "455": {
      "name": "Team Rocket Hideout (B2F)",
      "events": {
        "77": {
          "name": "Trainer(2) (Grunt — Rat Catcher)",
          "pages": {
            "0": {
              "conditions": {},
              "dialogue_blocks": [
                {
                  "start_index": 6,
                  "type": "text",
                  "lines": [
                    "Lost, little rat? This isn't",
                    "a place for kids with hero",
                    "complexes."
                  ]
                }
              ]
            },
            "1": {
              "conditions": {"self_switch": "A"},
              "dialogue_blocks": [
                {
                  "start_index": 1,
                  "type": "text",
                  "lines": [
                    "Boss! I'm sorry! The kid was",
                    "stronger than expected! They",
                    "always are, lately..."
                  ]
                }
              ]
            }
          }
        },
        "72": {
          "name": "Trainer(1) (Grunt — Confused)",
          "pages": {
            "0": {
              "conditions": {},
              "dialogue_blocks": [
                {
                  "start_index": 6,
                  "type": "text",
                  "lines": [
                    "Who are you? How did you",
                    "get past the sewers? Past",
                    "the locks? Past everyone?"
                  ]
                }
              ]
            },
            "1": {
              "conditions": {"self_switch": "A"},
              "dialogue_blocks": [
                {
                  "start_index": 1,
                  "type": "text",
                  "lines": [
                    "You think beating us changes",
                    "anything? Rocket's bigger",
                    "than this hideout. Bigger",
                    "than this city."
                  ]
                }
              ]
            }
          }
        },
        "74": {
          "name": "Trainer(3) (Grunt — Last Stand)",
          "pages": {
            "0": {
              "conditions": {},
              "dialogue_blocks": [
                {
                  "start_index": 6,
                  "type": "text",
                  "lines": [
                    "That's it. This is as far",
                    "as you go. The boss is",
                    "behind me and I won't fail."
                  ]
                }
              ]
            },
            "1": {
              "conditions": {"self_switch": "A"},
              "dialogue_blocks": [
                {
                  "start_index": 1,
                  "type": "text",
                  "lines": [
                    "Our boss is stronger than",
                    "any gym leader. He'll destroy",
                    "you. I almost feel sorry."
                  ]
                }
              ]
            }
          }
        },
        "75": {
          "name": "Trainer(1) (Grunt — Uniform Check)",
          "pages": {
            "0": {
              "conditions": {},
              "dialogue_blocks": [
                {
                  "start_index": 7,
                  "type": "text",
                  "lines": [
                    "I don't recognize you. That",
                    "uniform doesn't fit right.",
                    "Where did you steal it?"
                  ]
                },
                {
                  "start_index": 11,
                  "type": "text",
                  "lines": [
                    "You broke into our operation?",
                    "A kid? The League must be",
                    "desperate, sending children."
                  ]
                }
              ]
            },
            "1": {
              "conditions": {"self_switch": "A"},
              "dialogue_blocks": [
                {
                  "start_index": 1,
                  "type": "text",
                  "lines": [
                    "You won't get away with this.",
                    "Rocket has people everywhere.",
                    "Even in places you trust."
                  ]
                }
              ]
            }
          }
        }
      }
