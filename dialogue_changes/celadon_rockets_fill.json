      "name": "Team Rocket Hideout (B3F)",
      "events": {
        "77": {
          "name": "Trainer(1) (Grunt — B3F Rat Catcher)",
          "pages": {
            "0": {
              "conditions": {},
              "dialogue_blocks": [
                {
                  "start_index": 6,
                  "type": "text",
                  "lines": [
                    "You're still here? How many",
                    "of us do you have to beat",
                    "before you take a hint?"
                  ]
                }
              ]
            },
            "1": {
              "conditions": {"self_switch": "A"},
              "dialogue_blocks": [
                {
                  "start_index": 1,
                  "type": "text",
                  "lines": [
                    "Boss, I'm sorry... The kid",
                    "just won't stop. I've never",
                    "seen anyone this stubborn."
                  ]
                }
              ]
            }
          }
        },
        "72": {
          "name": "Trainer(1) (Grunt — Identity)",
          "pages": {
            "0": {
              "conditions": {},
              "dialogue_blocks": [
                {
                  "start_index": 6,
                  "type": "text",
                  "lines": [
                    "Who even are you? This is",
                    "the most secure facility in",
                    "Kanto and you just... walked",
                    "in?"
                  ]
                }
              ]
            },
            "1": {
              "conditions": {"self_switch": "A"},
              "dialogue_blocks": [
                {
                  "start_index": 1,
                  "type": "text",
                  "lines": [
                    "You think this is about good",
                    "and evil? We're the ones",
                    "making fusion available to",
                    "everyone. The League hoards it."
                  ]
                }
              ]
            }
          }
        },
        "74": {
          "name": "Trainer(3) (Grunt — Loyalist)",
          "pages": {
            "0": {
              "conditions": {},
              "dialogue_blocks": [
                {
                  "start_index": 6,
                  "type": "text",
                  "lines": [
                    "End of the line. Nobody gets",
                    "past me to the boss."
                  ]
                }
              ]
            },
            "1": {
              "conditions": {"self_switch": "A"},
              "dialogue_blocks": [
                {
                  "start_index": 1,
                  "type": "text",
                  "lines": [
                    "The boss will destroy you.",
                    "He's not like us grunts."
                  ]
                },
                {
                  "start_index": 3,
                  "type": "text",
                  "lines": [
                    "He has a vision. You're just",
                    "a kid with a badge collection."
                  ]
                }
              ]
            }
          }
        },
        "75": {
          "name": "Trainer(3) (Grunt — Suspicious)",
          "pages": {
            "0": {
              "conditions": {},
              "dialogue_blocks": [
                {
                  "start_index": 7,
                  "type": "text",
                  "lines": [
                    "That uniform's too small for",
                    "you. Dead giveaway."
                  ]
                },
                {
                  "start_index": 11,
                  "type": "text",
                  "lines": [
                    "Broke in? A child? This is",
                    "what passes for law enforce-",
                    "ment in Celadon. Pathetic."
                  ]
                }
              ]
            },
            "1": {
              "conditions": {"self_switch": "A"},
              "dialogue_blocks": [
                {
                  "start_index": 1,
