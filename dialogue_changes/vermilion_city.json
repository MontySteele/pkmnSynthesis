    "19": {
      "name": "Vermilion City",
      "events": {
        "22": {
          "name": "EV022 (Construction NPC)",
          "pages": {
            "0": {
              "conditions": {},
              "dialogue_blocks": [
                {
                  "start_index": 1,
                  "type": "text",
                  "lines": [
                    "Surge's got us working triple",
                    "shifts. New walls every week,",
                    "cameras he insists on inspecting",
                    "personally. The man doesn't sleep."
                  ]
                },
                {
                  "start_index": 3,
                  "type": "text",
                  "lines": [
                    "Good for business, I guess.",
                    "Noisy, though."
                  ]
                }
              ]
            }
          }
        },
        "23": {
          "name": "EV023 (Shore NPC)",
          "pages": {
            "0": {
              "conditions": {},
              "dialogue_blocks": [
                {
                  "start_index": 1,
                  "type": "text",
                  "lines": [
                    "I found this weird stone shining",
                    "on the sea shore earlier this",
                    "morning. You can have it — the",
                    "harbor's no place to linger now."
                  ]
                }
              ]
            },
            "1": {
              "conditions": {"self_switch": "A"},
              "dialogue_blocks": [
                {
                  "start_index": 1,
                  "type": "text",
                  "lines": [
                    "The sea, such a vast habitat",
                    "for so many Pok\u00e9mon."
                  ]
                },
                {
                  "start_index": 3,
                  "type": "text",
                  "lines": [
                    "Even Surge's patrol boats can't",
                    "control all of it. Beautiful,",
                    "don't you think?"
                  ]
                }
              ]
            }
          }
        }
      }
    },
    "24": {
      "name": "Vermilion City Gym",
      "events": {
        "2": {
          "name": "EV002 (Lt. Surge)",
          "pages": {
            "0": {
              "conditions": {},
              "dialogue_blocks": [
                {
                  "start_index": 11,
                  "type": "text",
                  "lines": [
                    "...Another challenger. Let me",
                    "look at you."
                  ]
                },
                {
                  "start_index": 15,
                  "type": "text",
                  "lines": [
                    "You cleared Surge's gym. That",
                    "means you got past my locks,",
                    "my trainers, and my security.",
                    "Not bad."
                  ]
                },
                {
                  "start_index": 19,
                  "type": "text",
                  "lines": [
                    "Fusion is a weapon, kid. And",
                    "weapons belong in trained hands.",
                    "The League's hands. My hands.",
                    "That's not opinion. That's order."
                  ]
                },
                {
                  "start_index": 34,
                  "type": "text",
                  "lines": [
                    "...You earned it. That's all",
                    "that matters to me. Take the",
                    "Thunder Badge."
                  ]
                },
                {
                  "start_index": 39,
                  "type": "text",
                  "lines": [
                    "The Thunder Badge cranks up",
                    "your Pok\u00e9mon's speed.",
                    "American-made reliability."
                  ]
                },
                {
                  "start_index": 42,
                  "type": "text",
                  "lines": [
                    "TM73 — Thunder Wave. Teach it",
                    "to an Electric Pok\u00e9mon. Shuts",
                    "your enemy down cold."
                  ]
                },
                {
                  "start_index": 46,
                  "type": "text",
                  "lines": [
                    "You're strong, kid. That means",
                    "you've got a say in how this",
                    "works."
                  ]
                },
                {
                  "start_index": 50,
                  "type": "insert_commands",
                  "_comment": "Surge asks the player: do you agree the League should run fusion? Sets Var 343 + Switches 1144-1146.",
                  "commands": [
                    {"code": 101, "indent": 1, "parameters": ["One more thing. The League runs"]},
                    {"code": 401, "indent": 1, "parameters": ["fusion. The League keeps order."]},
                    {"code": 401, "indent": 1, "parameters": ["You agree with that?"]},
                    {"code": 102, "indent": 1, "parameters": [["Yes, sir.", "No. I don't.", "It's more complicated than that."], 0]},
                    {"code": 402, "indent": 1, "parameters": [0, "Yes, sir."]},
                    {"code": 122, "indent": 2, "parameters": [343, 343, 0, 0, 1]},
                    {"code": 121, "indent": 2, "parameters": [1144, 1144, 0]},
                    {"code": 101, "indent": 2, "parameters": ["Good. Smart kid. Keep your head"]},
                    {"code": 401, "indent": 2, "parameters": ["on straight and you'll go far."]},
                    {"code": 402, "indent": 1, "parameters": [1, "No. I don't."]},
                    {"code": 122, "indent": 2, "parameters": [343, 343, 0, 0, 2]},
                    {"code": 121, "indent": 2, "parameters": [1145, 1145, 0]},
                    {"code": 101, "indent": 2, "parameters": ["Then you're naive. But you"]},
                    {"code": 401, "indent": 2, "parameters": ["earned that badge. I don't take"]},
                    {"code": 401, "indent": 2, "parameters": ["it back."]},
                    {"code": 101, "indent": 2, "parameters": ["Just don't come crying to me"]},
                    {"code": 401, "indent": 2, "parameters": ["when the world bites you."]},
                    {"code": 402, "indent": 1, "parameters": [2, "It's more complicated than that."]},
                    {"code": 122, "indent": 2, "parameters": [343, 343, 0, 0, 3]},
                    {"code": 121, "indent": 2, "parameters": [1146, 1146, 0]},
                    {"code": 101, "indent": 2, "parameters": ["Complicated. Yeah. That's what"]},
                    {"code": 401, "indent": 2, "parameters": ["people say when they don't want"]},
                    {"code": 401, "indent": 2, "parameters": ["to pick a side."]},
                    {"code": 101, "indent": 2, "parameters": ["World doesn't wait for you to"]},
                    {"code": 401, "indent": 2, "parameters": ["make up your mind, kid."]},
                    {"code": 404, "indent": 1, "parameters": []}
                  ]
                },
                {
                  "start_index": 56,
                  "type": "text",
                  "lines": [
                    "Come back when you're ready",
                    "to challenge me, soldier."
                  ]
                }
              ]
            },
            "1": {
              "conditions": {"switch1_id": 6},
              "dialogue_blocks": [
                {
                  "start_index": 1,
                  "type": "text",
                  "lines": [
                    "Word of advice, kid. Electric",
                    "power is devastating — but it's",
                    "useless against Ground types.",
                    "Know your enemy."
                  ]
                }
              ]
            }
          }
        },
        "4": {
          "name": "Trainer(5) — Gym Trainer (Recruit)",
          "pages": {
            "0": {
              "conditions": {},
              "dialogue_blocks": [
                {
                  "start_index": 14,
                  "type": "text",
                  "lines": [
                    "I enlisted under Surge last",
                    "year. \\V[5] Pok\u00e9mon are standard",
                    "issue here. You ready for that?"
                  ]
                }
              ]
            },
            "1": {
              "conditions": {"self_switch": "A"},
              "dialogue_blocks": [
                {
                  "start_index": 1,
                  "type": "text",
                  "lines": [
                    "All right, I'll talk! The Lt.",
                    "hid door switches inside",
