            },
            "1": {
              "conditions": {"self_switch": "A"},
              "dialogue_blocks": [
                {
                  "start_index": 10,
                  "type": "text",
                  "lines": [
                    "Yo! Champ in making! Lt. Surge",
                    "is the Lightning American —",
