                }
              ]
            },
            "2": {
              "conditions": {"switch1_id": 6},
              "dialogue_blocks": [
                {
                  "start_index": 1,
                  "type": "text",
                  "lines": [
                    "Your battle with the Lt. was",
                    "something else. Respect."
                  ]
                }
              ]
            }
          }
        },
        "6": {
          "name": "Trainer(5) — Gym Trainer (Seasoned)",
          "pages": {
            "0": {
              "conditions": {},
              "dialogue_blocks": [
                {
                  "start_index": 5,
                  "type": "text",
                  "lines": [
                    "This gym is a military post,",
                    "not a playground. Turn around",
                    "or get shocked."
                  ]
                }
              ]
            },
            "1": {
              "conditions": {"self_switch": "A"},
              "dialogue_blocks": [
                {
                  "start_index": 1,
                  "type": "text",
                  "lines": [
                    "The Lt. set up double locks."
                  ]
                },
                {
                  "start_index": 3,
                  "type": "text",
                  "lines": [
                    "Here's a tip — when you open",
                    "the 1st lock, the 2nd is right",
                    "next to it."
