            },
            "2": {
              "conditions": {"switch1_id": 6},
              "dialogue_blocks": [
                {
                  "start_index": 1,
                  "type": "text",
                  "lines": [
                    "You got through the Lt.'s",
                    "defenses. Impressive."
                  ]
                }
              ]
            }
          }
        },
        "7": {
          "name": "Trainer(5) — Gym Trainer (Veteran)",
          "pages": {
            "0": {
              "conditions": {},
              "dialogue_blocks": [
                {
                  "start_index": 5,
                  "type": "text",
                  "lines": [
                    "When I was in the Army, Surge",
                    "was my CO. Strict as they come.",
                    "His fused Pok\u00e9mon saved our",
                    "unit more than once."
                  ]
                }
              ]
            },
            "1": {
              "conditions": {"self_switch": "A"},
              "dialogue_blocks": [
                {
                  "start_index": 1,
                  "type": "text",
                  "lines": [
                    "Stairs won't come down? The",
                    "Lt. always was cautious. Check",
                    "the trash cans."
                  ]
                }
              ]
            },
            "2": {
              "conditions": {"switch1_id": 6},
              "dialogue_blocks": [
                {
                  "start_index": 1,
                  "type": "text",
                  "lines": [
                    "Keep going, kid. You've got",
                    "the kind of strength the Lt.",
                    "respects."
                  ]
                }
              ]
            }
          }
        },
        "11": {
          "name": "EV011 (Gym Guide)",
          "pages": {
            "0": {
              "conditions": {},
              "dialogue_blocks": [
                {
                  "start_index": 10,
                  "type": "text",
                  "lines": [
