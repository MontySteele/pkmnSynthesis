    "341": {
      "name": "Hall of Fame",
      "events": {
        "2": {
          "name": "oak",
          "pages": {
            "0": {
              "dialogue_blocks": [
                {
                  "start_index": 36,
                  "type": "text",
                  "lines": [
                    "...\\PN. Congratulations."
                  ]
                },
                {
                  "start_index": 38,
                  "type": "text",
                  "lines": [
                    "This is the Hall of Fame."
                  ]
                },
                {
                  "start_index": 40,
                  "type": "text",
                  "lines": [
                    "Every trainer who conquers",
                    "the Pok\u00e9mon League is",
                    "honored here -- along with",
                    "the Pok\u00e9mon who stood",
                    "beside them."
                  ]
                },
                {
                  "start_index": 44,
                  "type": "text",
                  "lines": [
                    "You've come a long way,",
                    "\\PN. From Pallet Town to",
                    "this room. Through every",
                    "trial this region had."
                  ]
                },
                {
                  "start_index": 47,
                  "type": "text",
                  "lines": [
                    "Congratulations, \\PN. You",
                    "and your Pok\u00e9mon are Hall",
                    "of Famers."
                  ]
                }
              ]
            }
          }
        }
      }
    }
