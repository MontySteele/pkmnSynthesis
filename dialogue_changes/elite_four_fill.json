            "0": {
              "dialogue_blocks": [
                {
                  "start_index": 12,
                  "type": "text",
                  "lines": [
                    "Welcome. I am Lorelei of",
                    "the Elite Four."
                  ]
                },
                {
                  "start_index": 15,
                  "type": "text",
                  "lines": [
                    "I grew up on the Sevii",
                    "Islands, where the sea",
                    "freezes in winter. My \\V[5]",
                    "Pok\u00e9mon learned patience",
                    "from that cold."
                  ]
                },
                {
                  "start_index": 18,
                  "type": "text",
                  "lines": [
                    "Shall I show you what that",
                    "patience looks like in battle?"
                  ]
