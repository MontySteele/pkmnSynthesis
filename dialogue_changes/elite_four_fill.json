        "17": {
          "name": "EV017",
          "pages": {
            "0": {
              "dialogue_blocks": [
                {
                  "start_index": 1,
                  "type": "text",
                  "lines": [
                    "D'ya know what's it mean",
                    "locking eyes with me?",
                    "Think yerself ready to",
                    "unlock my Hard Mode?"
                  ]
                },
                {
                  "start_index": 4,
                  "type": "text",
                  "lines": [
                    "Well, ye look tough, but ye",
                    "gotta prove yerself first."
                  ]
                },
                {
                  "start_index": 6,
                  "type": "text",
                  "lines": [
                    "Rematch every Gym Leader and",
                    "beat the champion again.",
                    "Maybe then I'll let you in",
                    "into my secret club!"
                  ]
                }
              ]
            },
            "1": {
              "dialogue_blocks": [
                {
                  "start_index": 2,
                  "type": "text",
                  "lines": [
                    "Hey, yer \\PN, right?"
                  ]
                },
                {
                  "start_index": 5,
                  "type": "text",
                  "lines": [
                    "So, ye got the invitation",
                    "I sent you?"
                  ]
                },
                {
                  "start_index": 13,
                  "type": "text",
                  "lines": [
                    "D'ya know what's it mean",
                    "locking eyes with me?",
                    "Think yerself ready to",
                    "unlock my Hard Mode?"
                  ]
                },
                {
                  "start_index": 15,
                  "type": "choices",
                  "choices": ["Yeah!", "Maybe later"],
                  "cancel_type": 0
                },
                {
                  "start_index": 18,
                  "type": "text",
                  "lines": [
                    "Lessee if ya got what it",
                    "takes. You'll only get",
                    "a taste!"
                  ]
                },
                {
                  "start_index": 40,
                  "type": "text",
                  "lines": [
                    "Heh. Yer not half bad!",
                    "Y'might actually do alright!",
                    "I have enabled Hard Mode",
                    "for you. Ya can talk to me",
                    "anytime if ya want to",
                    "disable it."
                  ]
                },
                {
                  "start_index": 44,
                  "type": "text",
                  "lines": [
                    "Or just wear this and",
                    "everyone'll know that ya",
                    "mean business!"
                  ]
                },
                {
                  "start_index": 47,
                  "type": "text",
                  "lines": [
                    "\\PN put on Dem's Badge."
                  ]
                },
                {
                  "start_index": 48,
                  "type": "text",
                  "lines": [
                    "While wearing Dem's Badge,",
                    "Gym Leaders, and the Elite 4",
                    "will now use their ultimate",
                    "teams against you."
                  ]
                },
                {
                  "start_index": 56,
                  "type": "text",
                  "lines": [
                    "Nope, not enough bruh.",
                    "If ya can't handle this,",
                    "the rest will be unhealthy",
                    "for ya."
                  ]
                },
                {
                  "start_index": 59,
                  "type": "text",
                  "lines": [
                    "I'm lookin' out for ya, see?",
                    "Come back when yer stronger."
                  ]
                },
                {
                  "start_index": 66,
                  "type": "text",
                  "lines": [
                    "Wise choice. If you barge in",
                    "unknown territory unprepared,",
                    "you'll only get hurt."
                  ]
                }
              ]
            },
            "2": {
              "dialogue_blocks": [
                {
                  "start_index": 1,
                  "type": "text",
                  "lines": [
                    "Do ya wanna protec yerself?",
                    "Or deal some damage?"
                  ]
                },
                {
                  "start_index": 3,
                  "type": "choices",
                  "choices": ["Protec...", "...Attac?", "Damage!", "On second thought..."],
                  "cancel_type": 4
                },
                {
                  "start_index": 6,
                  "type": "text",
                  "lines": [
                    "He protec,\nhe attac,\nbut most importantly,\nhe take Hard Mode bac."
                  ]
                },
                {
                  "start_index": 11,
                  "type": "text",
                  "lines": [
                    "Heh. Yer catchin' on.",
                    "I like ya."
                  ]
                },
                {
                  "start_index": 13,
                  "type": "text",
                  "lines": [
                    "He protec,\nhe attack,\nbut most importantly,\nHard Mode is bac!  Yeah baby!"
                  ]
                },
                {
                  "start_index": 19,
                  "type": "text",
                  "lines": [
                    "THATS A LOTTA DAMAGE!"
                  ]
                },
                {
                  "start_index": 43,
                  "type": "text",
                  "lines": [
                    "THATS A LOTTA DAMAGE!"
                  ]
                },
                {
                  "start_index": 64,
                  "type": "text",
                  "lines": [
                    "THATS A LOT-"
                  ]
                },
                {
                  "start_index": 66,
                  "type": "text",
                  "lines": [
                    "...huh? Ya beat Hard Mode Gold?\n'KAY THAN 'TIS TIEM FOR LEGEND SPAM!"
                  ]
                },
                {
                  "start_index": 85,
                  "type": "text",
                  "lines": [
                    "Yer good, kid. Yer really",
                    "good."
                  ]
                },
                {
                  "start_index": 88,
                  "type": "text",
                  "lines": [
                    "Go see that ol' professor",
                    "Oak and show him yer Gold",
                    "Emblem."
                  ]
                },
                {
                  "start_index": 101,
                  "type": "text",
                  "lines": [
                    "Huh? Alrighty then.\nYa can talk to me anytime if ya want to swap modes, or just spar."
                  ]
                }
              ]
            }
          }
        },
        "12": {
          "name": "Move Relearner",
          "pages": {
            "0": {
              "dialogue_blocks": [
                {
                  "start_index": 2,
                  "type": "text",
                  "lines": [
                    "Hello there, I'm the Move",
                    "Reminder."
                  ]
                },
                {
                  "start_index": 4,
                  "type": "text",
                  "lines": [
                    "I know every single move",
                    "that Pokemon learn growing",
                    "up."
                  ]
                },
                {
                  "start_index": 7,
                  "type": "text",
                  "lines": [
                    "\\GFor $2000 I can teach a",
                    "move to one of your Pok\u00e9mon."
                  ]
                },
                {
                  "start_index": 9,
                  "type": "text",
                  "lines": [
                    "\\GWhat do you think?"
                  ]
                },
                {
                  "start_index": 10,
                  "type": "choices",
                  "choices": ["Yes", "No"],
                  "cancel_type": 2
                },
                {
                  "start_index": 15,
                  "type": "text",
                  "lines": [
                    "Which Pok\u00e9mon needs tutoring?"
                  ]
                },
                {
                  "start_index": 24,
                  "type": "text",
                  "lines": [
                    "If your Pok\u00e9mon need to learn",
                    "a move, come back with a",
                    "Heart Scale."
                  ]
                },
                {
                  "start_index": 30,
                  "type": "text",
                  "lines": [
                    "Huh? There isn't a single",
                    "move that I can teach an Egg."
                  ]
                },
                {
                  "start_index": 37,
                  "type": "text",
                  "lines": [
                    "Sorry..."
                  ]
                },
                {
                  "start_index": 39,
                  "type": "text",
                  "lines": [
                    "It doesn't appear as if I",
                    "have any move I can teach",
                    "to your \\v[3]."
                  ]
                },
                {
                  "start_index": 45,
                  "type": "text",
                  "lines": [
                    "Which move should I teach",
                    "to your \\v[3]?"
                  ]
                },
                {
                  "start_index": 49,
                  "type": "text",
                  "lines": [
                    "\\G\\PN paid $2000 in exchange."
                  ]
                },
                {
                  "start_index": 51,
                  "type": "text",
                  "lines": [
                    "\\GIf your Pok\u00e9mon need to",
                    "learn a move, come back",
                    "with another $2000!."
                  ]
                },
                {
                  "start_index": 56,
                  "type": "text",
                  "lines": [
                    "If your Pok\u00e9mon need to learn",
                    "a move, come back with $2000."
                  ]
                },
                {
                  "start_index": 65,
                  "type": "text",
                  "lines": [
                    "Oh, but you don't have",
                    "enough money!"
                  ]
                }
              ]
            }
          }
        },
