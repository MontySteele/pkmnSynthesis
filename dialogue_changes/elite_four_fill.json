        "10": {
          "name": "Nurse",
          "pages": {
            "0": {
              "dialogue_blocks": [
                {
                  "start_index": 2,
                  "type": "text",
                  "lines": [
                    "\\^Hello, and welcome to the",
                    "Pok\u00e9mon Center.\\wt[2.5]"
                  ]
                },
                {
                  "start_index": 4,
                  "type": "text",
                  "lines": [
                    "\\^We restore your tired",
                    "Pok\u00e9mon to full health.\\wt[2.5]"
                  ]
                },
                {
                  "start_index": 6,
                  "type": "text",
                  "lines": [
                    "Would you like to rest your",
                    "Pok\u00e9mon?"
                  ]
                },
                {
                  "start_index": 7,
                  "type": "choices",
                  "choices": ["Yes", "No"],
                  "cancel_type": 2
                },
                {
                  "start_index": 10,
                  "type": "text",
                  "lines": [
                    "OK, I'll take your Pok\u00e9mon",
                    "for a few seconds."
                  ]
                },
                {
                  "start_index": 112,
                  "type": "text",
                  "lines": [
                    "\\rYour Pok\u00e9mon may be",
                    "infected by PokeRus."
                  ]
                },
                {
                  "start_index": 114,
                  "type": "text",
                  "lines": [
                    "\\rLittle is known about the",
                    "PokeRus except that they are",
                    "microscopic life-forms that",
                    "attach to Pok\u00e9mon."
                  ]
                },
                {
                  "start_index": 117,
                  "type": "text",
                  "lines": [
                    "\\rWhile infected, Pok\u00e9mon are",
                    "said to grow exceptionally",
                    "well."
                  ]
                },
                {
                  "start_index": 123,
                  "type": "text",
                  "lines": [
                    "Thank you for waiting."
                  ]
                },
                {
                  "start_index": 125,
                  "type": "text",
                  "lines": [
                    "We've restored your Pok\u00e9mon",
                    "to full health."
                  ]
                },
                {
                  "start_index": 127,
                  "type": "text",
                  "lines": [
                    "We hope to see you again!"
                  ]
                },
                {
                  "start_index": 133,
                  "type": "text",
                  "lines": [
                    "\\rWe hope to see you again!"
                  ]
                }
              ]
            }
          }
        }
      }
