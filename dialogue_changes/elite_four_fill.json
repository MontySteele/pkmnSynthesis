        "15": {
          "name": "EV015",
          "pages": {
            "0": {
              "dialogue_blocks": [
                {
                  "start_index": 1,
                  "type": "text",
                  "lines": [
                    "Beyond those doors, you'll",
                    "face the Elite Four one",
                    "by one. No rest between."
