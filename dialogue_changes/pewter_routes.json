    "106": {
      "name": "Route 4",
      "events": {
        "4": {
          "name": "EV004 (Cave NPC)",
          "pages": {
            "0": {
              "conditions": {},
              "dialogue_blocks": [
                {
                  "start_index": 1,
                  "type": "text",
                  "lines": [
                    "That cave up there...",
                    "Pok\u00e9mon come out stronger",
                    "than they should be. Like",
                    "something is changing them."
                  ]
                },
                {
                  "start_index": 3,
                  "type": "text",
                  "lines": [
                    "If you found a way inside,",
                    "you might find some really",
                    "powerful Pok\u00e9mon."
                  ]
                }
              ]
            }
          }
        },
        "5": {
          "name": "EV005 (Pokeradar/route mapper NPC)",
          "pages": {
            "0": {
              "conditions": {},
              "dialogue_blocks": [
                {
                  "start_index": 2,
                  "type": "text",
                  "lines": [
                    "That's it, that's every",
                    "last one of them!"
                  ]
                },
                {
                  "start_index": 4,
                  "type": "text",
                  "lines": [
                    "Now that you've mapped the",
                    "entire route, you should",
                    "be able to find this",
                    "route's \\C[1]rare encounter",
                    "\\C[0] with your Pok\u00e9radar."
                  ]
                },
                {
                  "start_index": 8,
                  "type": "text",
                  "lines": [
                    "Prof. Oak's distribution",
                    "data predicts it should be",
                    "a Normal-type Pok\u00e9mon",
                    "called \\C[1]Buneary\\C[0].",
                    "Use the Pok\u00e9radar and see",
                    "if you can find one!"
                  ]
                },
                {
                  "start_index": 16,
                  "type": "text",
                  "lines": [
                    "You're almost there!",
                    "There's only one more",
                    "Pok\u00e9mon that should appear",
                    "on this route at this time",
                    "of day."
                  ]
                },
                {
                  "start_index": 19,
                  "type": "text",
                  "lines": [
                    "It's the Pok\u00e9mon called",
                    "\\C[1]\\V[1]\\C[0]. It must",
                    "be pretty rare!"
                  ]
                },
                {
                  "start_index": 24,
                  "type": "text",
                  "lines": [
                    "According to my field",
                    "data, there should still",
                    "be \\V[2] more Pok\u00e9mon that",
                    "you can encounter on this",
                    "route at this time of day."
                  ]
                },
                {
                  "start_index": 30,
                  "type": "text",
                  "lines": [
                    "Your Pok\u00e9radar's light",
                    "will flash green when you",
                    "have encountered every",
                    "Pok\u00e9mon on a route. Come",
                    "and see me when it does!"
                  ]
                }
              ]
            }
          }
        },
        "15": {
          "name": "EV015 (Route trainer)",
          "pages": {
            "0": {
              "conditions": {},
              "dialogue_blocks": [
                {
                  "start_index": 5,
                  "type": "text",
                  "lines": [
                    "Route 4's quiet now that",
                    "people take the Mt. Moon",
                    "tunnel. I practically have",
                    "this whole stretch to",
                    "myself!"
                  ]
                }
              ]
            },
            "1": {
              "conditions": {
                "self_switch": "A"
              },
              "dialogue_blocks": [
                {
                  "start_index": 1,
                  "type": "text",
                  "lines": [
