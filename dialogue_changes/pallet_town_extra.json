                }
              ]
            }
          }
        },
        "3": {
          "name": "EV003 (Mart Clerk)",
          "pages": {
            "0": {
              "conditions": {},
              "dialogue_blocks": [
                {
                  "start_index": 1,
                  "type": "text",
                  "lines": [
                    "First time on Route 1? You'll",
                    "want supplies. There's a Mart",
                    "in Viridian -- stop by!"
                  ]
                },
                {
                  "start_index": 4,
                  "type": "text",
                  "lines": [
                    "Here -- take this. Consider it",
                    "a going-away present."
                  ]
                }
              ]
            },
            "1": {
              "conditions": {
                "self_switch": "A"
              },
              "dialogue_blocks": [
                {
                  "start_index": 0,
                  "type": "text",
                  "lines": [
                    "We carry Poke Balls too, once",
                    "you're ready to start catching.",
                    "Good luck out there!"
                  ]
                }
              ]
            }
          }
        }
      }
    },
