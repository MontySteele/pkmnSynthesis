          "pages": {
            "0": {
              "conditions": {},
              "dialogue_blocks": [
                {
                  "start_index": 1,
                  "type": "text",
                  "lines": [
                    "Have you seen \\V[12] today?"
                  ]
                },
                {
                  "start_index": 3,
                  "type": "text",
                  "lines": [
                    "He was up before dawn, pacing",
                    "around the yard. Could barely",
                    "sleep, that one."
                  ]
                }
              ]
            },
            "1": {
              "conditions": {
                "switch1_id": 63
              },
              "dialogue_blocks": [
                {
                  "start_index": 3,
                  "type": "text",
                  "lines": [
                    "\\PN! Well, don't you look ready",
                    "for the road."
                  ]
                },
                {
                  "start_index": 7,
                  "type": "text",
                  "lines": [
                    "Hold on -- your hair's a mess.",
                    "Let me fix it before you go.",
                    "A trainer should look the part!"
                  ]
                }
              ]
            }
          }
        },
        "9": {
          "name": "EV009 (Rival's Sibling)",
          "pages": {
            "0": {
              "conditions": {},
              "dialogue_blocks": [
                {
                  "start_index": 1,
                  "type": "text",
                  "lines": [
                    "Hey, \\PN! Big day, huh?"
                  ]
                },
                {
                  "start_index": 3,
                  "type": "text",
                  "lines": [
                    "\\V[12] told me not to give you",
                    "this map..."
                  ]
                },
                {
                  "start_index": 5,
                  "type": "text",
                  "lines": [
                    "So naturally, here you go!"
                  ]
                },
                {
                  "start_index": 8,
                  "type": "text",
                  "lines": [
                    "It's got all the routes marked.",
                    "Stay safe out there, okay?"
                  ]
                }
              ]
            },
            "1": {
              "conditions": {
                "self_switch": "A"
              },
              "dialogue_blocks": [
                {
                  "start_index": 1,
                  "type": "text",
                  "lines": [
                    "Oh -- hey again, \\PN!"
                  ]
                },
                {
                  "start_index": 3,
                  "type": "text",
                  "lines": [
                    "What's that nickname you gave",
                    "my brother again?"
                  ]
                },
                {
                  "start_index": 8,
                  "type": "text",
                  "lines": [
                    "Right -- \\V[12]! He actually",
                    "kind of likes it. Don't tell",
                    "him I said that."
                  ]
                }
              ]
            }
          }
        }
