    "97": {
      "name": "Route 1 (Gate)",
      "events": {
        "2": {
          "name": "EV002 (Gate NPC)",
          "pages": {
            "0": {
              "conditions": {},
              "dialogue_blocks": [
                {
                  "start_index": 1,
                  "type": "text",
                  "lines": [
                    "Viridian City's just ahead.",
                    "You're almost through Route 1."
