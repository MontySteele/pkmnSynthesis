    "503": {
      "name": "Celadon City (Philosopher House)",
      "events": {
        "1": {
          "name": "EV001 (City Pride)",
          "pages": {
            "0": {
              "conditions": {},
              "dialogue_blocks": [
                {
                  "start_index": 1,
                  "type": "text",
                  "lines": [
                    "Celadon is the largest city",
                    "in Kanto. Well, Saffron's",
                    "bigger, but more people live",
                    "here. The smart ones, anyway."
                  ]
                },
                {
                  "start_index": 3,
                  "type": "text",
                  "lines": [
                    "Saffron has Silph Co. and its",
                    "regulations. Celadon has the",
                    "Game Corner and its... lack",
                    "of them. People prefer freedom."
                  ]
                }
              ]
            }
          }
        },
        "7": {
          "name": "EV007 (Pokemon Philosopher)",
          "pages": {
            "0": {
              "conditions": {},
              "dialogue_blocks": [
                {
                  "start_index": 1,
                  "type": "text",
                  "lines": [
                    "I wonder what it feels like",
                    "to be a Pok\u00e9mon."
                  ]
                },
                {
                  "start_index": 3,
                  "type": "text",
                  "lines": [
                    "Especially a fused one. Two",
                    "minds sharing one body. Do",
                    "they argue? Agree? Or just",
                    "exist in quiet compromise?"
                  ]
                }
              ]
            }
          }
        },
