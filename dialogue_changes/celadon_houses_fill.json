    "393": {
      "name": "Celadon City (Roost Tutor House)",
      "events": {
        "3": {
          "name": "EV003 (Dratini Owner)",
          "pages": {
            "0": {
              "conditions": {},
              "dialogue_blocks": [
                {
                  "start_index": 1,
                  "type": "text",
                  "lines": [
                    "What do you think of my rare",
                    "Dratini? Cost me a fortune at",
                    "the Game Corner."
                  ]
                },
                {
                  "start_index": 3,
                  "type": "text",
                  "lines": [
                    "They say the prize Pok\u00e9mon",
                    "come from somewhere offshore.",
                    "Best not to ask where."
                  ]
                }
              ]
            }
          }
        },
        "4": {
          "name": "EV004 (Dratini Cry)",
          "_note": "MECHANICAL — Pokemon cry. Preserved."
        }
      }
    },
    "450": {
      "name": "Celadon City (Student House)",
      "events": {
        "2": {
          "name": "EV002 (University Student)",
          "pages": {
            "0": {
              "conditions": {},
              "dialogue_blocks": [
                {
                  "start_index": 1,
                  "type": "text",
                  "lines": [
                    "I'm studying economics at",
                    "Celadon University."
                  ]
                },
                {
                  "start_index": 3,
                  "type": "text",
                  "lines": [
                    "My thesis is on how unlicensed",
                    "fusion markets affect local GDP.",
                    "My advisor said to keep it",
                    "'theoretical.' Sure."
                  ]
                }
              ]
            }
          }
        },
        "3": {
          "name": "EV003 (Lazy Roommate)",
          "pages": {
            "0": {
              "conditions": {},
              "dialogue_blocks": [
                {
                  "start_index": 1,
                  "type": "text",
                  "lines": [
                    "Studying is for try-hards."
                  ]
                },
                {
                  "start_index": 3,
                  "type": "text",
                  "lines": [
                    "Why stress about a degree when",
                    "half the city's income comes",
                    "from the Game Corner anyway?",
                    "The economy runs itself."
                  ]
                }
              ]
            }
          }
        }
      }
    },
    "451": {
      "name": "Celadon City (Sewer Awareness House)",
      "events": {
        "3": {
          "name": "EV003 (Sewer Expert)",
          "pages": {
            "0": {
              "conditions": {},
              "dialogue_blocks": [
                {
                  "start_index": 1,
                  "type": "text",
                  "lines": [
                    "The sewers have always had",
                    "wild Pok\u00e9mon. Grimer, mostly."
                  ]
                },
                {
                  "start_index": 3,
                  "type": "text",
                  "lines": [
                    "But lately there are fused ones",
                    "down there. Someone's been",
                    "dumping failed experiments.",
                    "The city won't investigate."
                  ]
                }
              ]
            }
          }
        },
        "4": {
          "name": "EV004 (Pollution Realist)",
          "pages": {
            "0": {
              "conditions": {},
              "dialogue_blocks": [
                {
                  "start_index": 1,
                  "type": "text",
                  "lines": [
                    "Nobody likes to admit it, but",
                    "this city has a pollution",
                    "problem beneath the surface."
                  ]
                },
                {
                  "start_index": 4,
                  "type": "text",
                  "lines": [
                    "The gardens look perfect. The",
                    "sewers tell a different story.",
                    "Guess which one gets funding."
                  ]
                }
              ]
            }
          }
        }
      }
    },
    "452": {
