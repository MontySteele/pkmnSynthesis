    "500": {
      "name": "Celadon City (Concerned Resident House)",
      "events": {
        "5": {
          "name": "EV005 (Rocket Worry)",
          "pages": {
            "0": {
              "conditions": {},
              "dialogue_blocks": [
                {
                  "start_index": 1,
                  "type": "text",
                  "lines": [
                    "Team Rocket's been getting",
                    "bolder lately. Used to keep",
                    "to the Game Corner."
                  ]
                },
                {
                  "start_index": 3,
                  "type": "text",
                  "lines": [
                    "Now I see them in the streets.",
                    "And Erika does nothing.",
                    "She says it's 'under control.'",
                    "Whose control, exactly?"
