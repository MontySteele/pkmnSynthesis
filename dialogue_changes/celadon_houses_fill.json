        "4": {
          "name": "EV004 (Dreamer — Fusion Killed Dreams)",
          "pages": {
            "0": {
              "conditions": {},
              "dialogue_blocks": [
                {
                  "start_index": 1,
                  "type": "text",
                  "lines": [
                    "Growing up, my dream was to",
                    "catch every Pok\u00e9mon."
                  ]
                },
                {
                  "start_index": 4,
                  "type": "text",
                  "lines": [
                    "Then Silph invented fusion and",
                    "suddenly there were thousands.",
                    "Progress ruined the one thing",
                    "I wanted to accomplish."
                  ]
                }
              ]
            }
          }
        }
      }
