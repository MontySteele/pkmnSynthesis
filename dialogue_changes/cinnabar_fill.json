    "808": {
      "name": "Seafoam Islands B1",
      "_note": "Ice climbing mechanics, Pokemon eggs, trainer battles -- ALL PRESERVED. The Blaine NPC (E16) already has atmospheric dialogue about fire and ice juxtaposition. No Synthesis rewrite needed.",
      "events": {
        "16": {
          "name": "Blaine's Colleague (Seafoam)",
          "pages": {
            "0": {
              "conditions": { "switch1_id": 12, "switch2_id": 14 },
              "dialogue_blocks": [
                {
                  "start_index": 1,
                  "type": "text",
                  "lines": [
                    "Oh, hello \\PN. What a",
                    "coincidence seeing you",
                    "here."
                  ]
                },
                {
                  "start_index": 3,
                  "type": "text",
                  "lines": [
                    "This place has always",
                    "fascinated me. So close",
                    "to the volcano, yet",
                    "frigid as ice itself."
                  ]
                },
                {
                  "start_index": 6,
                  "type": "text",
                  "lines": [
                    "Fire and ice. Creation",
                    "and preservation. Blaine",
                    "understood that duality.",
                    "It's what drew him to",
                    "this island. And what",
                    "nearly destroyed him."
                  ]
                }
              ]
            }
          }
        }
      }
    }
