              ]
            },
            "1": {
              "conditions": {
                "switch1_id": 1038
              },
              "dialogue_blocks": [
                {
                  "start_index": 1,
                  "type": "text",
                  "lines": [
                    "Don't you dare go any",
                    "higher. The upper floors",
                    "are off-limits to everyone",
                    "except the Boss himself."
                  ]
                }
              ]
            },
            "2": {
              "conditions": {
                "switch1_id": 231
              },
              "dialogue_blocks": [
                {
                  "start_index": 1,
                  "type": "text",
                  "lines": [
                    "Turn back now. You have",
                    "no idea what's waiting",
                    "for you up there."
                  ]
                }
              ]
            }
          }
        },
