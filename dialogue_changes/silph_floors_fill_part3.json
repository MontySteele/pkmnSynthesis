        "17": {
          "name": "EV017 \u2014 Senior Scientist Hostage",
          "pages": {
            "0": {
              "conditions": {},
              "dialogue_blocks": [
                {
                  "start_index": 2,
                  "type": "text",
                  "lines": [
                    "Your boss... Giovanni...",
                    "He made me watch while they",
                    "tested the Splicer on a",
                    "living Pok\u00e9mon."
                  ]
                },
                {
                  "start_index": 4,
                  "type": "text",
                  "lines": [
                    "The sounds it made...",
                    "I'll never forget them."
                  ]
                },
                {
                  "start_index": 7,
                  "type": "text",
                  "lines": [
                    "Wait\u2014you're not with them?"
                  ]
                },
                {
                  "start_index": 11,
                  "type": "text",
                  "lines": [
                    "Giovanni forced our entire",
                    "fusion research team to work",
                    "on his project. Day and night."
                  ]
                },
                {
                  "start_index": 13,
                  "type": "text",
                  "lines": [
                    "He doesn't see Pok\u00e9mon as",
                    "living creatures. Just raw",
                    "material to be recombined."
                  ]
                },
                {
                  "start_index": 15,
                  "type": "text",
                  "lines": [
                    "If he gets the Master Ball",
                    "prototype too... he'll be",
                    "able to capture anything.",
                    "Even Legendaries."
                  ]
                },
                {
                  "start_index": 19,
                  "type": "text",
                  "lines": [
                    "You actually did it...",
                    "Thank you. I thought no one",
                    "was coming for us."
                  ]
                }
              ]
            }
          }
        },
        "23": {
          "name": "EV023 \u2014 Research Papers",
          "pages": {
            "0": {
              "conditions": {},
              "dialogue_blocks": [
                {
                  "start_index": 0,
                  "type": "text",
                  "lines": [
                    "DNA fusion trial logs.",
                    "Most entries are redacted",
                    "with heavy black ink."
                  ]
                }
              ]
            }
          }
        },
        "12": {
          "name": "EV012 \u2014 Trainer(4) Rocket Enforcer",
          "pages": {
            "0": {
              "conditions": {},
              "dialogue_blocks": [
                {
                  "start_index": 6,
                  "type": "text",
                  "lines": [
                    "Nobody gets past this point.",
                    "Giovanni's orders. I enforce",
                    "them personally."
                  ]
