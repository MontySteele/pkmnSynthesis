    "517": {
      "name": "Route 18",
      "events": {
        "16": {
          "name": "Trainer(4) (Farmer — Pumpkins)",
          "pages": {
            "0": {
              "conditions": {},
              "dialogue_blocks": [
                {
                  "start_index": 5,
                  "type": "text",
                  "lines": [
                    "Hey! Hands off my pumpkins!",
                    "I grow them honest. No fusion,",
                    "no Rocket fertilizer. Just",
                    "soil and patience."
                  ]
                }
              ]
            },
            "1": {
              "conditions": {"self_switch": "A"},
              "dialogue_blocks": [
                {
                  "start_index": 1,
                  "type": "text",
                  "lines": [
                    "Swear I've seen some of these",
                    "pumpkins move at night. Maybe",
                    "it's the moonlight. Maybe",
                    "it's Pumpkaboo."
                  ]
                }
              ]
            }
          }
        },
        "23": {
          "name": "Trainer(5) (Ex-Biker)",
          "pages": {
            "0": {
              "conditions": {},
              "dialogue_blocks": [
                {
                  "start_index": 5,
                  "type": "text",
                  "lines": [
                    "They kicked me off Cycling",
                    "Road! Said I was 'disrupting",
                    "the atmosphere.' Whatever",
                    "that means."
                  ]
                }
              ]
            },
            "1": {
              "conditions": {"self_switch": "A"},
              "dialogue_blocks": [
                {
                  "start_index": 1,
                  "type": "text",
                  "lines": [
                    "I'd recruit you for our biker",
                    "gang but you don't look the",
                    "part. Too clean. Too hopeful."
                  ]
                }
              ]
            }
          }
        },
        "24": {
          "name": "Trainer(4) (Speed Racer)",
          "pages": {
            "0": {
              "conditions": {},
              "dialogue_blocks": [
                {
                  "start_index": 5,
                  "type": "text",
                  "lines": [
                    "Gotta go fast! Faster than",
                    "the news from Celadon. If",
                    "you ride fast enough, the",
                    "problems can't catch you."
                  ]
                }
              ]
            },
            "1": {
              "conditions": {"self_switch": "A"},
              "dialogue_blocks": [
                {
                  "start_index": 1,
                  "type": "text",
                  "lines": [
                    "Here. Take this. Speed is",
                    "a trainer's best friend.",
                    "Second best is ignorance."
                  ]
                }
              ]
            }
          }
        },
        "13": {
          "name": "Trainer(4) (Berry Forager)",
          "pages": {
            "0": {
              "conditions": {},
              "dialogue_blocks": [
                {
                  "start_index": 5,
                  "type": "text",
                  "lines": [
                    "Rare berries grow around",
                    "here! Wild ones, untouched",
                    "by Silph's modifications.",
                    "Like nature intended."
                  ]
                }
              ]
            },
            "1": {
              "conditions": {"self_switch": "A"},
              "dialogue_blocks": [
                {
                  "start_index": 1,
                  "type": "text",
                  "lines": [
                    "Found these not far from",
                    "here. Organic. Pre-fusion.",
                    "The way berries used to be."
                  ]
                }
              ]
            }
          }
        },
        "25": {
          "name": "Trainer(4) (Bird Lover)",
          "pages": {
            "0": {
              "conditions": {},
              "dialogue_blocks": [
                {
                  "start_index": 5,
                  "type": "text",
                  "lines": [
                    "Fly or Teleport? I say Fly.",
                    "Bird Pok\u00e9mon don't care about",
                    "city politics. They just go",
                    "where the wind takes them."
                  ]
                }
              ]
            },
            "1": {
              "conditions": {"self_switch": "A"},
              "dialogue_blocks": [
                {
                  "start_index": 1,
                  "type": "text",
                  "lines": [
                    "Bird Pok\u00e9mon are my true love.",
                    "Free. Unregistered. No fusion",
                    "license required for the sky."
                  ]
                }
              ]
            }
          }
        },
        "14": {
          "name": "Trainer(4) (Wilderness Seeker)",
          "pages": {
            "0": {
              "conditions": {},
              "dialogue_blocks": [
                {
                  "start_index": 5,
                  "type": "text",
                  "lines": [
                    "I'm here for the cathartic",
                    "wilderness experience. After",
                    "Celadon, I needed air that",
                    "doesn't smell like money."
                  ]
                }
              ]
            },
            "1": {
              "conditions": {"self_switch": "A"},
              "dialogue_blocks": [
                {
                  "start_index": 1,
                  "type": "text",
                  "lines": [
                    "More! I need more! Nature",
                    "heals what the city breaks."
                  ]
                }
              ]
            }
          }
        },
        "15": {
          "name": "Trainer(4) (Harvest Farmer)",
          "pages": {
            "0": {
              "conditions": {},
              "dialogue_blocks": [
                {
                  "start_index": 5,
                  "type": "text",
                  "lines": [
                    "It's harvest season, but I",
                    "always make time for battles.",
                    "Honest work and honest fights.",
                    "Not like in the city."
                  ]
                }
              ]
            },
            "1": {
              "conditions": {"self_switch": "A"},
              "dialogue_blocks": [
                {
                  "start_index": 1,
                  "type": "text",
                  "lines": [
                    "Harvest season waits for no",
                    "one. But another fight won't",
                    "hurt. The crops can wait."
                  ]
                }
              ]
            }
          }
        },
