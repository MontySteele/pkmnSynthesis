    "351": {
      "name": "Route 9",
      "events": {
        "2": {
          "name": "EV002 — Jetpack NPC (quest)",
          "pages": {
            "0": {
              "conditions": {},
              "dialogue_blocks": [
                {
                  "start_index": 1,
                  "type": "text",
                  "lines": [
                    "Using Pokémon to scale",
                    "waterfalls? That's one approach."
                  ]
                },
                {
                  "start_index": 4,
                  "type": "text",
                  "lines": [
                    "Want to know how I do it",
                    "without one?"
                  ]
                },
                {
                  "start_index": 6,
                  "type": "text",
                  "lines": [
                    "Show me a Pokémon that knows",
                    "\\C[1]Aqua Jet, Waterfall\\C[0]",
                    "and \\C[1]Fly\\C[0], and I'll",
                    "share the secret."
                  ]
                },
                {
                  "start_index": 19,
                  "type": "text",
                  "lines": [
                    "Not quite. It needs all three",
                    "moves."
                  ]
                },
                {
                  "start_index": 23,
                  "type": "text",
                  "lines": [
                    "That's the one! A real water",
                    "sports enthusiast. I'm surprised",
                    "you didn't know already."
                  ]
                },
                {
                  "start_index": 26,
                  "type": "text",
                  "lines": [
                    "The secret is a water-propelled",
                    "\\C[1]Jetpack\\C[0]. Like this",
                    "one right here."
                  ]
                },
                {
                  "start_index": 30,
                  "type": "text",
                  "lines": [
                    "Trust me — it's a blast to use."
                  ]
                }
              ]
            },
            "1": {
              "conditions": {
                "self_switch": "A"
              },
              "dialogue_blocks": [
                {
                  "start_index": 1,
                  "type": "text",
                  "lines": [
                    "That \\C[1]Jetpack\\C[0] lets you",
                    "climb waterfalls without needing",
                    "a Pokémon."
                  ]
                },
                {
                  "start_index": 4,
                  "type": "text",
                  "lines": [
                    "Also, it's just really fun."
                  ]
                }
              ]
            }
          }
        }
      }
