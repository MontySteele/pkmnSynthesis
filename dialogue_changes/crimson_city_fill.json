    "168": {
      "name": "Crimson City",
      "events": {
        "4": {
          "name": "EV004",
          "pages": {
            "0": {
              "conditions": {},
              "dialogue_blocks": [
                {
                  "start_index": 4,
                  "type": "text",
                  "lines": [
                    "The nightmares won't stop.",
                    "Every night, the same",
                    "thing. I can't sleep."
                  ]
                },
                {
                  "start_index": 9,
                  "type": "text",
                  "lines": [
                    "Forgive me -- where are my",
                    "manners."
                  ]
                },
                {
                  "start_index": 13,
                  "type": "text",
                  "lines": [
                    "I'm a Pokemon researcher.",
                    "Genetics, specifically."
                  ]
                },
                {
                  "start_index": 15,
                  "type": "text",
                  "lines": [
                    "I came to this remote place",
                    "to focus. No distractions.",
                    "No League oversight."
                  ]
                },
                {
                  "start_index": 18,
                  "type": "text",
                  "lines": [
                    "After years of work, I",
                    "developed something. A new",
                    "tool for fusion research."
                  ]
                },
                {
                  "start_index": 21,
                  "type": "choices",
                  "choices": ["Yes", "No"]
                },
                {
                  "start_index": 28,
                  "type": "text",
                  "lines": [
                    "This device is the result",
                    "of years of study on",
                    "Pokemon DNA recombination."
                  ]
                }
              ]
            }
          }
        }
      }
    },
    "169": {
      "name": "Crimson City",
      "events": {
        "5": {
          "name": "EV005",
          "pages": {
            "0": {
              "conditions": {},
              "dialogue_blocks": [
                {
                  "start_index": 1,
                  "type": "text",
                  "lines": [
                    "The Pokeball is a modern",
                    "invention, you know."
