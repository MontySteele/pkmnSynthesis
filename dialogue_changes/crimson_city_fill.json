        "37": {
          "name": "EV037",
          "pages": {
            "0": {
              "conditions": {},
              "dialogue_blocks": [
                {
                  "start_index": 0,
                  "type": "text",
                  "lines": [
                    "Rock percussion. Primitive",
                    "but powerful."
                  ]
                },
                {
                  "start_index": 1,
                  "type": "text",
                  "lines": [
                    "The Geodude seem to like",
                    "the rhythm."
                  ]
                }
              ]
            }
          }
        },
        "9": {
          "name": "EV009",
          "pages": {
            "0": {
              "conditions": {},
              "dialogue_blocks": [
                {
                  "start_index": 1,
                  "type": "text",
                  "lines": [
                    "This town's so small it",
                    "doesn't appear on most",
                    "maps. That's the point."
                  ]
                }
              ]
            }
          }
        }
      }
