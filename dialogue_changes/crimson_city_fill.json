              ]
            }
          }
        },
        "4": {
          "name": "EV004",
          "pages": {
            "0": {
              "conditions": {},
              "dialogue_blocks": [
                {
                  "start_index": 1,
                  "type": "text",
                  "lines": [
                    "Humans and Pokemon have",
                    "lived together for",
                    "thousands of years."
                  ]
                },
                {
                  "start_index": 4,
                  "type": "text",
                  "lines": [
                    "And we still know almost",
                    "nothing about them.",
                    "Isn't that strange?"
                  ]
