          "pages": {
            "0": {
              "conditions": {},
              "dialogue_blocks": [
                {
                  "start_index": 2,
                  "type": "text",
                  "lines": [
                    "It's you again! The fossil kid",
                    "from Mt. Moon! We keep running",
