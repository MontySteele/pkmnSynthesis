                },
                {
                  "start_index": 5,
                  "type": "text",
                  "lines": [
                    "I've been exploring caves all",
                    "over the region. Found even",
                    "more fossils. The black market",
                    "pays well, but I'd rather trade."
                  ]
                }
              ]
            },
            "2": {
              "conditions": {"self_switch": "B"},
              "dialogue_blocks": [
                {
                  "start_index": 1,
                  "type": "text",
                  "lines": [
                    "I'm training up these fossil",
                    "Pok\u00e9mon. Once they evolve,",
                    "they'll be worth a fortune.",
                    "...After this meal, though."
                  ]
                }
              ]
            }
          }
        },
        "13": {
          "name": "EV013 (Gossip — Gambler)",
          "pages": {
            "0": {
              "conditions": {},
              "dialogue_blocks": [
                {
                  "start_index": 1,
                  "type": "text",
                  "lines": [
                    "Munch... See that guy? Lost",
