    "542": {
      "name": "Celadon City Gym (Rematch)",
      "events": {
        "5": {
          "name": "Trainer(4) (Gym Trainer -- Sprouts Rematch)",
          "pages": {
            "0": {
              "conditions": {},
              "dialogue_blocks": [
                {
                  "start_index": 6,
                  "type": "text",
                  "lines": [
                    "Pok\u00e9mon are like sprouts.",
                    "They grow their whole lives.",
                    "Forcing fusion is like forcing",
                    "a flower to bloom early."
                  ]
                }
              ]
            },
            "1": {
              "conditions": {"self_switch": "A"},
              "dialogue_blocks": [
                {
                  "start_index": 1,
                  "type": "text",
                  "lines": [
                    "Bleaah! Erika will show you",
                    "what harmony really means."
                  ]
                }
              ]
            },
            "2": {
              "conditions": {"switch1_id": 7},
              "dialogue_blocks": [
                {
                  "start_index": 2,
                  "type": "text",
                  "lines": [
                    "That was remarkable. Erika",
                    "barely flinched."
                  ]
                },
                {
                  "start_index": 5,
                  "type": "text",
                  "lines": [
                    "She never does. Even when",
                    "she loses. Especially then."
                  ]
                }
              ]
            }
          }
        },
        "6": {
          "name": "Trainer(3) (Gym Trainer -- Hobbyist Rematch)",
          "pages": {
            "0": {
              "conditions": {},
              "dialogue_blocks": [
                {
                  "start_index": 5,
                  "type": "text",
                  "lines": [
                    "Pleased to meet you again.",
                    "I train here because Erika",
                    "values patience over power.",
                    "Refreshing. And convenient."
                  ]
                }
              ]
            },
            "1": {
              "conditions": {"self_switch": "A"},
              "dialogue_blocks": [
                {
                  "start_index": 1,
                  "type": "text",
                  "lines": [
                    "Our leader Erika may be",
                    "quiet, but she's the most",
                    "skilled trainer in this gym.",
                    "Don't let the calm fool you."
                  ]
                }
              ]
            },
            "2": {
              "conditions": {"switch1_id": 7},
              "dialogue_blocks": [
                {
                  "start_index": 1,
                  "type": "text",
                  "lines": [
                    "Excellent fight! You earned",
                    "that badge twice over."
                  ]
                }
              ]
            }
          }
        },
        "1": {
          "name": "Trainer(4) (Gym Trainer -- Gatekeeper Rematch)",
          "pages": {
            "0": {
              "conditions": {},
              "dialogue_blocks": [
                {
                  "start_index": 5,
                  "type": "text",
                  "lines": [
                    "Back again? Erika's been",
                    "expecting you. She expected",
                    "you'd return. She expects",
                    "most things."
                  ]
                }
              ]
            },
            "1": {
              "conditions": {"self_switch": "A"},
              "dialogue_blocks": [
                {
                  "start_index": 10,
                  "type": "text",
                  "lines": [
                    "We only use Grass-type",
                    "Pok\u00e9mon at our gym."
                  ]
                },
                {
                  "start_index": 12,
                  "type": "text",
                  "lines": [
                    "We also use them for flower",
                    "arrangements. The ones that",
                    "aren't fused, anyway."
                  ]
                }
              ]
            },
            "2": {
              "conditions": {"switch1_id": 7},
              "dialogue_blocks": [
                {
                  "start_index": 1,
                  "type": "text",
                  "lines": [
                    "What a fight that was! Erika",
                    "gave it everything this time."
                  ]
                }
              ]
            }
          }
        },
        "7": {
          "name": "Trainer(3) (Gym Trainer -- No Bugs Rematch)",
          "pages": {
            "0": {
              "conditions": {},
              "dialogue_blocks": [
                {
                  "start_index": 5,
                  "type": "text",
                  "lines": [
                    "No bugs or fire types in the",
                    "greenhouse, please. We keep",
                    "things... delicate here."
                  ]
                }
              ]
            },
            "1": {
              "conditions": {"self_switch": "A"},
              "dialogue_blocks": [
                {
                  "start_index": 1,
                  "type": "text",
                  "lines": [
                    "Erika may be quiet, but her",
                    "Pok\u00e9mon speak volumes."
                  ]
                }
              ]
            },
            "2": {
              "conditions": {"switch1_id": 7},
              "dialogue_blocks": [
                {
                  "start_index": 3,
                  "type": "text",
                  "lines": [
                    "Good job on that Rainbow",
                    "Badge! You've earned Erika's",
                    "respect. That's not easy."
                  ]
                }
              ]
            }
          }
        },
        "2": {
          "name": "Trainer(4) (Gym Trainer -- Easy to Raise Rematch)",
          "pages": {
            "0": {
              "conditions": {},
              "dialogue_blocks": [
                {
                  "start_index": 14,
                  "type": "text",
                  "lines": [
                    "Look at my Grass Pok\u00e9mon!",
                    "They practically raise",
                    "themselves. Like Celadon's",
                    "economy. Self-sustaining."
                  ]
                }
              ]
            },
            "1": {
              "conditions": {"self_switch": "A"},
              "dialogue_blocks": [
                {
                  "start_index": 1,
                  "type": "text",
                  "lines": [
                    "I have a date coming up.",
                    "Erika says good manners cost",
                    "nothing. Neither does looking",
                    "the other way, apparently."
                  ]
                }
              ]
            },
            "2": {
              "conditions": {"switch1_id": 7},
              "dialogue_blocks": [
                {
                  "start_index": 1,
                  "type": "text",
                  "lines": [
                    "You fought with grace and",
                    "elegance. Erika would approve.",
                    "She always approves."
                  ]
                }
              ]
            }
          }
        },
        "8": {
          "name": "Trainer(1) (Gym Trainer -- Mother Rematch)",
          "pages": {
            "0": {
              "conditions": {},
              "dialogue_blocks": [
                {
                  "start_index": 5,
                  "type": "text",
                  "lines": [
                    "Be strong, my Pok\u00e9mon. Be",
                    "strong for mother. And for",
                    "Celadon. Whatever that means",
                    "these days."
                  ]
                }
              ]
            },
            "1": {
              "conditions": {"self_switch": "A"},
              "dialogue_blocks": [
                {
                  "start_index": 1,
                  "type": "text",
                  "lines": [
                    "I didn't bring my best team!",
                    "Wait until next time!"
                  ]
                }
              ]
            },
            "2": {
              "conditions": {"switch1_id": 7},
              "dialogue_blocks": [
                {
                  "start_index": 3,
                  "type": "text",
                  "lines": [
                    "Congratulations on the badge!",
                    "Erika speaks highly of you.",
                    "Which is how she speaks of",
                    "everything. But still."
                  ]
                },
                {
                  "start_index": 7,
                  "type": "text",
                  "lines": [
                    "Unbelievable!"
                  ]
                }
              ]
            }
          }
        },
        "3": {
          "name": "Trainer(1) (Gym Trainer -- Flowers Rematch)",
          "pages": {
            "0": {
              "conditions": {},
              "dialogue_blocks": [
                {
                  "start_index": 5,
                  "type": "text",
                  "lines": [
                    "Eek! Don't step on the",
                    "flowers! They're the only",
                    "honest thing in this city."
                  ]
                }
              ]
            },
            "1": {
              "conditions": {"self_switch": "A"},
              "dialogue_blocks": [
                {
                  "start_index": 1,
                  "type": "text",
                  "lines": [
                    "Grass-types are tough against",
                    "Water. They also have an edge",
                    "on Rock and Ground types."
                  ]
                },
                {
                  "start_index": 3,
                  "type": "text",
                  "lines": [
                    "But their real strength is",
                    "patience. Like Erika's."
                  ]
                }
              ]
            },
            "2": {
              "conditions": {"switch1_id": 7},
              "dialogue_blocks": [
                {
                  "start_index": 1,
                  "type": "text",
                  "lines": [
                    "Well earned, that badge.",
                    "Erika respects strength",
                    "paired with restraint."
                  ]
                }
              ]
            }
          }
        },
        "9": {
          "name": ". (Erika -- Rematch)",
          "pages": {
            "0": {
              "conditions": {},
              "dialogue_blocks": [
                {
                  "start_index": 10,
                  "type": "text",
                  "lines": [
                    "Hello. Lovely weather, isn't",
                    "it? Everything in Celadon",
                    "is pleasant. ...Oh dear.",
                    "I must have dozed off."
                  ]
                },
                {
                  "start_index": 13,
                  "type": "text",
                  "lines": [
                    "Welcome back, \\PN. I had",
                    "a feeling you'd return."
                  ]
                },
                {
                  "start_index": 16,
                  "type": "text",
                  "lines": [
                    "So you've come to challenge",
                    "me again? How persistent."
                  ]
                },
                {
                  "start_index": 18,
                  "type": "text",
                  "lines": [
                    "I'm grateful for your help",
                    "with Team Rocket, but that",
                    "won't make me go easy on you.",
                    "I have a reputation to keep."
                  ]
                },
                {
                  "start_index": 21,
                  "type": "text",
                  "lines": [
                    "I shall use three Pok\u00e9mon.",
                    "Choose yours."
                  ]
                },
                {
                  "start_index": 34,
                  "type": "text",
                  "lines": [
                    "Oh! I concede. You remain",
                    "remarkably strong. Perhaps",
                    "stronger than before."
                  ]
                }
              ]
            },
            "1": {
              "conditions": {"self_switch": "A"},
              "dialogue_blocks": [
                {
                  "start_index": 2,
                  "type": "text",
                  "lines": [
                    "Good luck on your journey,",
                    "\\PN. Celadon will be here",
                    "when you return. It always",
                    "is. Nothing changes here."
                  ]
                }
              ]
            }
          }
        },
        "4": {
          "name": "Trainer(2) (Peeping Tom Rematch)",
          "pages": {
            "0": {
              "conditions": {},
              "dialogue_blocks": [
                {
                  "start_index": 5,
                  "type": "text",
                  "lines": [
                    "Aren't you the peeping Tom?",
                    "In Celadon, everyone watches",
                    "everyone. It's practically",
                    "civic duty."
                  ]
                }
              ]
            },
            "1": {
              "conditions": {"self_switch": "A"},
              "dialogue_blocks": [
                {
                  "start_index": 1,
                  "type": "text",
                  "lines": [
                    "Oh, you weren't peeping?",
                    "We get a lot of gawkers.",
                    "Celadon's gym is... popular",
                    "for the wrong reasons."
                  ]
                }
              ]
            }
          }
        }
      }
