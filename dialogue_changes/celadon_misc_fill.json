    "408": {
      "name": "Pokemon Center",
      "events": {
        "6": {
          "name": "EV006 (Bike Wisher)",
          "pages": {
            "0": {
              "conditions": {},
              "dialogue_blocks": [
                {
                  "start_index": 1,
                  "type": "text",
                  "lines": [
                    "Man, I wish I had a bike.",
                    "The Cycling Road's the only",
                    "route to Fuchsia that doesn't",
                    "pass through Rocket territory."
                  ]
                },
                {
                  "start_index": 3,
                  "type": "text",
                  "lines": [
                    "Well, all roads pass through",
                    "someone's territory around",
                    "here. But at least on a bike",
                    "you can outrun them."
                  ]
                }
              ]
            }
          }
        },
        "7": {
          "name": "EV007 (Stone Shopper)",
          "pages": {
            "0": {
              "conditions": {},
              "dialogue_blocks": [
                {
                  "start_index": 1,
                  "type": "text",
                  "lines": [
                    "I heard the Dept. Store sells",
                    "evolutionary stones. Licensed",
                    "ones, even."
                  ]
                },
                {
                  "start_index": 4,
                  "type": "text",
                  "lines": [
                    "The Game Corner sells them",
                    "too, cheaper. But you don't",
                    "know where those came from.",
                    "Or from whom."
                  ]
                }
              ]
            }
          }
        },
        "5": {
          "name": "EV005 (Ponyta Trader)",
          "_note": "MECHANICAL -- Pokemon trade. Preserved entirely."
        },
