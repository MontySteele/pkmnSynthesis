              "conditions": {},
              "dialogue_blocks": [
                {
                  "start_index": 4,
                  "type": "text",
                  "lines": [
                    "Two against one. That's\nhow it works out here."
                  ]
                },
                {
                  "start_index": 6,
                  "type": "text",
                  "lines": [
                    "Lavender taught us that\nstrength is better shared."
                  ]
                },
                {
                  "start_index": 9,
                  "type": "text",
