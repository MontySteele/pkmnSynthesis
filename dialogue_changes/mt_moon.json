        "37": {
          "name": "EV037 (Major Rocket scene at 15,14)",
          "pages": {
            "0": {
              "conditions": {
                "switch1_id": 208
              },
              "dialogue_blocks": [
                {
                  "start_index": 4,
                  "type": "text",
                  "lines": [
                    "What? Who let this child",
                    "in here?"
                  ]
                },
                {
                  "start_index": 11,
                  "type": "text",
                  "lines": [
                    "We can't afford distractions.",
                    "Someone deal with this. Now."
                  ]
                },
                {
                  "start_index": 18,
                  "type": "text",
                  "lines": [
                    "Yes, Commander. You -- the",
                    "researcher. Come here."
                  ]
                },
                {
                  "start_index": 27,
                  "type": "text",
                  "lines": [
                    "Please... I was just looking",
                    "for fossils. I don't want any",
                    "part of this."
                  ]
                },
                {
                  "start_index": 31,
                  "type": "text",
                  "lines": [
                    "You heard the Commander. Deal",
                    "with the kid. Or else."
                  ]
                },
                {
                  "start_index": 33,
                  "type": "text",
                  "lines": [
                    "What did I get myself into..."
                  ]
                },
                {
                  "start_index": 43,
                  "type": "text",
                  "lines": [
                    "I'm sorry, kid. They're",
                    "forcing my hand..."
                  ]
                },
                {
                  "start_index": 48,
                  "type": "text",
                  "lines": [
                    "Commander! The fusion device",
                    "is ready. Starting the",
                    "sequence now!"
                  ]
                },
                {
                  "start_index": 96,
                  "type": "text",
                  "lines": [
                    "No... no!"
                  ]
                },
                {
                  "start_index": 98,
                  "type": "text",
                  "lines": [
                    "The specimen is in distress!",
                    "It shouldn't be reacting",
                    "like this!"
                  ]
                },
                {
                  "start_index": 102,
                  "type": "text",
                  "lines": [
                    "Shut it down. Now."
                  ]
                },
                {
                  "start_index": 104,
                  "type": "text",
                  "lines": [
                    "This wasn't a failure. This",
                    "was a prototype. We'll get",
                    "it right."
                  ]
                },
                {
                  "start_index": 107,
                  "type": "text",
                  "lines": [
                    "The Moon Stone array",
                    "overloaded... I can recalibrate",
                    "if you let me..."
                  ]
                },
                {
                  "start_index": 110,
                  "type": "text",
                  "lines": [
                    "Enough. We'll continue this",
                    "at headquarters."
                  ]
                },
                {
                  "start_index": 114,
                  "type": "text",
                  "lines": [
                    "Do we have enough Moon Stones",
                    "for a second attempt?"
                  ]
                },
                {
                  "start_index": 118,
                  "type": "text",
                  "lines": [
                    "Yes, Commander. We collected",
                    "every Moon Stone in the cave.",
                    "More than enough."
                  ]
                },
                {
                  "start_index": 123,
                  "type": "text",
                  "lines": [
                    "Good. Pack the equipment and",
                    "the stones. This triple fusion",
                    "device will work. But not here.",
                    "Not tonight."
                  ]
                },
                {
                  "start_index": 129,
                  "type": "text",
                  "lines": [
                    "I won't let you down again,",
                    "Commander."
                  ]
                },
                {
                  "start_index": 131,
                  "type": "text",
                  "lines": [
                    "Pack up. We're moving out.",
                    "Leave nothing behind."
                  ]
                }
              ]
            }
