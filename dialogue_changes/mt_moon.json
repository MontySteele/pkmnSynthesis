          "_extended_prebattle_dialogue": [
            {
              "speaker": "Earnest Grunt",
              "lines": [
                "Wait. You're just a kid.",
                "A licensed trainer? Of course",
                "you are."
              ]
            },
            {
              "speaker": "Earnest Grunt",
              "lines": [
                "Look, I don't want to fight",
                "you."
              ]
            },
            {
              "speaker": "Earnest Grunt",
              "lines": [
                "Do you know what it costs to",
                "get a fusion license? Do you",
                "know how long the waitlist is?"
              ]
            },
            {
              "speaker": "Earnest Grunt",
              "lines": [
                "People on Route 4 are losing",
                "Pok\u00e9mon to wild Onix because",
                "the League won't let them fuse",
                "a Pok\u00e9mon strong enough."
              ]
            },
            {
              "speaker": "Earnest Grunt",
              "lines": [
                "We're not stealing anything.",
                "We're trying to build something",
                "that gives people access.",
                "That's all."
              ]
            },
            {
              "speaker": "Aggressive Grunt",
              "lines": [
                "Enough talking. The kid's seen",
                "too much. Handle it or I will."
              ]
            },
            {
              "speaker": "Earnest Grunt",
              "lines": [
                "...Fine. I'm sorry about this."
              ]
            }
          ]
        },
